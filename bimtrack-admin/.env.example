# Salin menjadi .env.local lalu isi dari Firebase Console > Project settings > Your apps (app Web "admin").
# .env.local TIDAK boleh di-commit (sudah ada di .gitignore).
VITE_FIREBASE_API_KEY=isi-api-key
VITE_FIREBASE_AUTH_DOMAIN=isi-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=isi-project-id
VITE_FIREBASE_STORAGE_BUCKET=isi-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=isi-sender-id
VITE_FIREBASE_APP_ID=isi-app-id-web-admin
